# ==============================================================================
# VAXORA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Neon PostgreSQL Database Connection String
ConnectionStrings__DefaultConnection="Host=your_neon_host.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=your_password;SSL Mode=Require;Trust Server Certificate=true"

# JWT Token Settings
Jwt__SecretKey="Your32ByteMinimumLengthSecretKeyHere!#"
Jwt__Issuer="Vaxora.Api"
Jwt__Audience="Vaxora.Client"
Jwt__ExpiryInMinutes=120

# Cloudflare R2 Credentials
CloudflareR2__AccountId="your_cloudflare_account_id"
CloudflareR2__AccessKeyId="your_r2_access_key_id"
CloudflareR2__SecretAccessKey="your_r2_secret_access_key"
CloudflareR2__BucketName="vaxora-docs"
CloudflareR2__PublicUrl="https://pub-your-id.r2.dev"

# System Admin Seed Account
AdminSeed__Email="admin@vaxora.health.gov.lk"
AdminSeed__Password="Admin@Vaxora2026"
