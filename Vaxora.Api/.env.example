# ==============================================================================
# VAXORA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Neon PostgreSQL Database Connection String
ConnectionStrings__DefaultConnection="Host=your_neon_host.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=your_password;SSL Mode=Require;Trust Server Certificate=true"

# JWT Token Settings
Jwt__SecretKey="Your32ByteMinimumLengthSecretKeyHere!#"
Jwt__Issuer="Vaxora.Api"
Jwt__Audience="Vaxora.Client"
Jwt__ExpiryInMinutes=120

# Cloudflare R2 Credentials
CloudflareR2__AccountId="your_cloudflare_account_id"
CloudflareR2__AccessKeyId="your_r2_access_key_id"
CloudflareR2__SecretAccessKey="your_r2_secret_access_key"
CloudflareR2__BucketName="vaxora-docs"
CloudflareR2__PublicUrl="https://pub-your-id.r2.dev"

# System Admin Seed Account
AdminSeed__Email="admin@vaxora.health.gov.lk"
AdminSeed__Password="Admin@Vaxora2026"

# PayHere Payment Gateway (Sandbox)
PayHere__MerchantId=""
PayHere__MerchantSecret=""
PayHere__CheckoutUrl="https://sandbox.payhere.lk/pay/checkout"
PayHere__Currency="LKR"

# Internal Agentic AI service (Python FastAPI)
AGENT_SERVICE_URL="http://localhost:8001"
AGENT_SERVICE_KEY=""
AgentService__TimeoutSeconds="120"

# ==============================================================================
# SMTP Email Service Configuration (EmailService.cs)
# ==============================================================================
Smtp__Host="smtp.gmail.com"
Smtp__Port=587
Smtp__Username="your_email@gmail.com"
Smtp__Password="your_app_password"
Smtp__FromEmail="your_email@gmail.com"
Smtp__FromName="Vaxora Immunization Platform"
Smtp__EnableSsl=true

# Alternative direct environment variables supported by EmailService
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM_EMAIL="your_email@gmail.com"
SMTP_FROM_NAME="Vaxora Immunization Platform"
SMTP_ENABLE_SSL=true

# ==============================================================================
# RunPod API & LLM Service Configuration
# ==============================================================================
RUNPOD_API_KEY="your_runpod_api_key_here"
RUNPOD_BASE_URL="https://api.runpod.ai/v2"
RUNPOD_POD_ID=""
RUNPOD_ENDPOINT_ID=""
RunPod__ApiKey="your_runpod_api_key_here"
RunPod__BaseUrl="https://api.runpod.ai/v2"

