# ============================================================
# Vaxora Agent Service — Example Environment
# Copy this file to `.env` and fill in your own values.
# ============================================================

# ---------- Inventory Agents (RestockAgent, ExpiryAgent) ----------
# Groq Cloud — https://console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# ---------- Shared OpenAI-compatible LLM (RUNPOD_* aliases) ----------
# Used by: BookingAgent, StaffSchedulingAgent, PatientDataAgent, CarePlanningAgent
# Point these at Groq, RunPod, or Gemini — same keys as below.

# Option A — Groq (common for patient care agents)
RUNPOD_BASE_URL=https://api.groq.com/openai/v1
RUNPOD_API_KEY=your-groq-api-key-here
MODEL_NAME=openai/gpt-oss-120b

# Option B — RunPod vLLM / Ollama pod (common for booking + staff scheduling)
# RUNPOD_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# RUNPOD_API_KEY=no-need
# MODEL_NAME=qwen3:14b

# Option C — Google Gemini (OpenAI-compatible endpoint)
# RUNPOD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# RUNPOD_API_KEY=your-gemini-key-here
# MODEL_NAME=gemini-2.5-flash

# ---------- Vaxora ASP.NET Core API ----------
# Must include the /api suffix
VAXORA_API_BASE_URL=http://localhost:5004/api

# ---------- Agent-to-API shared secret ----------
# When set, must match AGENT_SERVICE_KEY in Vaxora.Api/.env
AGENT_SERVICE_KEY=

# ---------- Agent FastAPI Server ----------
PORT=8001
HOST=0.0.0.0
