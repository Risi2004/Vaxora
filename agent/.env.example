# ============================================================
# Vaxora Agent Service — Example Environment
# Copy this file to `.env` and fill in your own values.
# ============================================================

# ---------- LLM Provider (OpenAI-compatible) ----------
# Groq Cloud (recommended for local dev)
RUNPOD_BASE_URL=https://api.groq.com/openai/v1
RUNPOD_API_KEY=your-groq-api-key-here
MODEL_NAME=llama-3.3-70b-versatile

# Alternative — RunPod vLLM / Ollama pod
# RUNPOD_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# RUNPOD_API_KEY=no-need
# MODEL_NAME=qwen3:14b

# Alternative — Google Gemini (OpenAI-compatible endpoint)
# RUNPOD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# RUNPOD_API_KEY=your-gemini-key-here
# MODEL_NAME=gemini-2.5-flash

# ---------- Vaxora ASP.NET Core API ----------
# Must include the /api suffix
VAXORA_API_BASE_URL=http://localhost:5004/api

# Optional shared secret between the ASP.NET API and this agent service.
# When set, it must match AGENT_SERVICE_KEY in Vaxora.Api/.env
AGENT_SERVICE_KEY=

# ---------- Agent FastAPI Server ----------
PORT=8001
HOST=0.0.0.0