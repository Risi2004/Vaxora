# RunPod LLM Configuration (OpenAI Compatible Endpoint)
# Example for RunPod vLLM/Ollama pod: https://<pod-id>-8000.proxy.runpod.net/v1
RUNPOD_BASE_URL=https://runpod-id-11434.proxy.runpod.net/v1
RUNPOD_API_KEY=no-need
MODEL_NAME=qwen3:14b

# Groq LLM (Inventory Agents)
# Get key at: https://console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Vaxora ASP.NET Core API Base URL (must include /api)
VAXORA_API_BASE_URL=http://localhost:5004/api

# Optional shared secret; must match AGENT_SERVICE_KEY on the API when set
AGENT_SERVICE_KEY=

# Agent Service Port
PORT=8001
HOST=0.0.0.0
