# ============================================================
# Vaxora Agent Service — Example Environment
# Copy this file to `.env` and fill in your own values.
# ============================================================

# ---------- OpenRouter LLM Configuration (PRIMARY) ----------
# All agents (BookingAgent, StaffSchedulingAgent, RestockAgent, ExpiryAgent,
# PatientDataAgent, CarePlanningAgent, and Orchestrator) use this single endpoint.
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=qwen/qwen3.8-27b

# Other popular OpenRouter models:
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ---------- Legacy: alternative OpenAI-compatible providers ----------
# If you prefer a different backend over OpenRouter, some agents may also
# accept the RUNPOD_* aliases below. Both should point to the same provider.
# RUNPOD_BASE_URL=https://api.groq.com/openai/v1
# RUNPOD_API_KEY=your-key
# MODEL_NAME=qwen/qwen3.8-27b

# ---------- Vaxora ASP.NET Core API ----------
# Must include the /api suffix
VAXORA_API_BASE_URL=http://localhost:5004/api

# ---------- Agent-to-API shared secret ----------
# When set, must match AGENT_SERVICE_KEY in Vaxora.Api/.env
AGENT_SERVICE_KEY=

# ---------- Agent FastAPI Server ----------
PORT=8001
HOST=0.0.0.0
